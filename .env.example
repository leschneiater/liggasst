# Public client configuration only.
# Never add database passwords, service-role keys, private keys or other secrets
# to a VITE_* variable. Vite embeds these values in the browser bundle.

# Supabase Configuration
VITE_SUPABASE_URL=https://your-project.supabase.co
VITE_SUPABASE_ANON_KEY=your_public_anon_key

# Other public client keys (if needed)
VITE_GOOGLE_MAPS_API_KEY=your_google_maps_key
VITE_STRIPE_PUBLISHABLE_KEY=your_stripe_key
